# =============================================================================
# SupplyChainIQ - Render & Production Environment Variables (.env)
# =============================================================================

# Server Environment
NODE_ENV=production

# Render automatically sets PORT, but 10000 is Render's default web service port
PORT=10000

# -----------------------------------------------------------------------------
# MongoDB Database Connection
# -----------------------------------------------------------------------------
# For MongoDB Atlas (Free M0 Sandbox):
# 1. Sign up at https://www.mongodb.com/atlas
# 2. Create a free cluster -> Database Access (create user/pass) -> Network Access (Allow 0.0.0.0/0)
# 3. Copy connection string and paste below:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/supplychainiq?retryWrites=true&w=majority

# NOTE: If MONGODB_URI is left empty or omitted, SupplyChainIQ will automatically
# boot in resilient in-memory mode pre-seeded with 30 SKUs and 5,620 transactions!
MONGODB_URI=

# -----------------------------------------------------------------------------
# Python ML Forecasting Service (Optional)
# -----------------------------------------------------------------------------
# If you deploy python_service as a separate Render web service, provide its URL:
# PYTHON_SERVICE_URL=https://supplychainiq-python.onrender.com
# If omitted or offline, the platform automatically uses its pure JS forecasting engine.
PYTHON_SERVICE_URL=
